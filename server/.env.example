# SchoolPing Backend Configuration Template
# Copy this file to .env and configure your environment variables.
# NEVER commit .env to source control!

PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/schoolping or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/schoolping

# JWT Secret for Session Authentication (Use a high-entropy 256-bit string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# CORS Allowed Origins
CORS_ORIGIN=*

# Future WhatsApp Cloud API Credentials (Server-side only)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
